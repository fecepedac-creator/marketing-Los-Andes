# =========================================================
# PANEL EDITORIAL LOS ANDES - ENVIRONMENT VARIABLES
# =========================================================

# -----------------------------
# Firebase Client SDK (PUBLIC)
# Used in browser for Firebase Auth client login flow.
# Must be prefixed NEXT_PUBLIC_ because Next.js exposes them to frontend.
# -----------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------
# Firebase Admin SDK (SERVER ONLY)
# Used by API routes/server code for Firestore + Storage admin operations.
# NEVER expose these in frontend code.
# -----------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# -----------------------------
# Access control
# Must match:
# 1) real admin user email in Firebase Auth
# 2) middleware/guard expectations
# 3) firestore/storage rules (if email-based rules are kept)
# -----------------------------
ADMIN_EMAIL=admin@centromedicolosandes.cl

# -----------------------------
# OpenAI (SERVER ONLY)
# Used by /api/generate-image.
# NEVER expose in frontend.
# -----------------------------
OPENAI_API_KEY=
